{
  "name": "@warp/multi-agent-api-v1",
  "version": "0.0.1",
  "description": "Generated TypeScript bindings for Warp multi-agent API v1",
  "type": "module",
  "exports": {
    "./*_pb": {
      "types": "./*_pb.d.ts",
      "import": "./*_pb.js",
      "default": "./*_pb.js"
    },
    "./*_pb.js": {
      "types": "./*_pb.d.ts",
      "import": "./*_pb.js",
      "default": "./*_pb.js"
    }
  },
  "files": [
    "*.ts",
    "*.js",
    "*.d.ts"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0"
  },
  "license": "UNLICENSED",
  "private": true
}
