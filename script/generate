#!/bin/bash
#
# Script to generate language bindings for a proto API.
#
# Usage:
#   ./script/generate -a <api> [-v <version>]
#
# Options:
#   -a, --api <api>     The API to generate bindings for
#   -v, --version <version> The version of the API to generate bindings for
#
# Example:
#   ./script/generate -a multi_agent -v v1

set -e

API=""
VERSION="v1"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--api)
      API="$2"
      shift 2
      ;;
    -v|--version)
      VERSION="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [ -z "$API" ]; then
  echo "Error: API (-a|--api) is required"
  echo "Available APIs:"
  APIS=($(ls -1 apis))
  for api in "${APIS[@]}"; do
    echo " - $api"
  done
  exit 1
fi

if [ -z "$VERSION" ]; then
  echo "Error: Version (-v|--version) is required"
  exit 1
fi

echo "Generating bindings for $API $VERSION..."

echo "Source protos:"
API_PATH="apis/$API/$VERSION"
PROTO_FILES=($(cd "$API_PATH" > /dev/null && ls -1 *.proto))
for proto in "${PROTO_FILES[@]}"; do
  echo " - $API_PATH/$proto"
done

echo -e "\n➡️  Generating Go bindings..."
if [ -d "$API_PATH/gen/go" ]; then
  # Extract go_package from first proto file
  GO_MODULE=$(grep 'option go_package' "$API_PATH/"*.proto 2>/dev/null | head -1 | sed 's/.*option go_package = "\([^"]*\)".*/\1/' | sed 's/[;[:space:]]*$//')
  if [ -z "$GO_MODULE" ]; then
    GO_MODULE="github.com/warp/warp-proto-apis/$API/$VERSION"
  fi
  
  GO_GRPC_OPTS=()
  # Check if any proto file defines a gRPC service
  if grep -q '^service ' "$API_PATH/"*.proto 2>/dev/null; then
    GO_GRPC_OPTS=(--go-grpc_out="$API_PATH/gen/go" --go-grpc_opt="module=$GO_MODULE")
    echo "  (service detected — generating gRPC stubs)"
  fi
  PROTO_FILES_WITH_PATH=()
  for proto in "${PROTO_FILES[@]}"; do
    PROTO_FILES_WITH_PATH+=("$API/$VERSION/$proto")
  done
  protoc --go_out="$API_PATH/gen/go" --go_opt="module=$GO_MODULE" "${GO_GRPC_OPTS[@]}" --proto_path="$(realpath "apis")" "${PROTO_FILES_WITH_PATH[@]}"
  pushd "$API_PATH/gen/go" >/dev/null 2>&1
  go mod tidy
  popd >/dev/null 2>&1
  echo "✅️ Done generating Go bindings"
else
  echo "⏭️  Skipping Go (no gen/go directory)"
fi

echo -e "\n➡️  Generating Python bindings..."
if [ -d "$API_PATH/gen/python" ]; then
  GRPC_PYTHON_PLUGIN=$(which grpc_python_plugin)
  if [ -z "$GRPC_PYTHON_PLUGIN" ]; then
    echo "Error: grpc_python_plugin not found. Run ./script/bootstrap to install."
    exit 1
  fi
  # Strip Go-specific directives
  PY_TMPDIR=$(mktemp -d)
  for proto in "${PROTO_FILES[@]}"; do
    sed \
      -e '/import "google\/protobuf\/go_features.proto";/d' \
      -e '/option features\./d' \
      "$(realpath "$API_PATH/$proto")" > "$PY_TMPDIR/$proto"
  done

  PROTO_FILES_WITH_PATH=()
  for proto in "${PROTO_FILES[@]}"; do
    PROTO_FILES_WITH_PATH+=("$API/$VERSION/$proto")
  done

  protoc \
    --proto_path="$(realpath "apis")" \
    --proto_path="$PY_TMPDIR" \
    --python_out="$API_PATH/gen/python" \
    --grpc_python_out="$API_PATH/gen/python" \
    --plugin=protoc-gen-grpc_python="$GRPC_PYTHON_PLUGIN" \
    "${PROTO_FILES_WITH_PATH[@]}"
  rm -rf "$PY_TMPDIR"
  touch "$API_PATH/gen/python/__init__.py"
  echo "✅️ Done generating Python bindings"
else
  echo "⏭️  Skipping Python (no gen/python directory)"
fi
