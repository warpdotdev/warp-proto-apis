#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_PATH="$ROOT_DIR/apis/multi_agent/v1"
OUT_DIR="$ROOT_DIR/generated"
PLUGIN_PATH="$ROOT_DIR/node_modules/.bin/protoc-gen-es"

if ! command -v protoc >/dev/null 2>&1; then
  echo "Error: protoc is required but was not found in PATH." >&2
  echo "Install protoc: https://protobuf.dev/installation/" >&2
  exit 1
fi

if [ ! -x "$PLUGIN_PATH" ]; then
  echo "Error: protoc-gen-es is missing." >&2
  echo "Run 'npm install' in $ROOT_DIR to install dev dependencies." >&2
  exit 1
fi

PROTO_FILES=()
while IFS= read -r file; do
  PROTO_FILES+=("$file")
done < <(cd "$API_PATH" && ls -1 *.proto | sort)

if [ ${#PROTO_FILES[@]} -eq 0 ]; then
  echo "Error: no proto files found in $API_PATH" >&2
  exit 1
fi

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

PROTO_INPUTS=("${PROTO_FILES[@]/#/$API_PATH/}")

protoc \
  --plugin="protoc-gen-es=$PLUGIN_PATH" \
  --es_out="$OUT_DIR" \
  --es_opt="target=js+dts,import_extension=js" \
  --proto_path="$API_PATH" \
  "${PROTO_INPUTS[@]}"

protoc \
  --plugin="protoc-gen-es=$PLUGIN_PATH" \
  --es_out="$OUT_DIR" \
  --es_opt="target=ts,import_extension=js" \
  --proto_path="$API_PATH" \
  "${PROTO_INPUTS[@]}"

echo "Generated TypeScript bindings in $OUT_DIR"
